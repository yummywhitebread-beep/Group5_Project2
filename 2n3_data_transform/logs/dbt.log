    create or replace table `ringed-griffin-509403-b4`.`propery_trans1`.`fact_transaction`
      
    
    

    
    OPTIONS()
    as (
      WITH transactions AS (
    SELECT
        *,
        ROW_NUMBER() OVER (
            ORDER BY TO_JSON_STRING(STRUCT(
                project_name,
                transacted_price,
                area_sqft,
                unit_price_psf,
                sale_date,
                address,
                type_of_sale,
                type_of_area,
                area_sqm,
                unit_price_psm,
                nett_price,
                property_type,
                number_of_units,
                tenure,
                completion_date,
                purchaser_address_indicator,
                postal_code,
                postal_district,
                postal_sector,
                planning_region,
                planning_area
            ))
        ) AS transaction_row_number
    FROM `ringed-griffin-509403-b4`.`propery_trans1`.`stg_property_transactions`
)
SELECT
    FARM_FINGERPRINT(CONCAT(
        TO_JSON_STRING(STRUCT(
            project_name,
            transacted_price,
            area_sqft,
            unit_price_psf,
            sale_date,
            address,
            type_of_sale,
            type_of_area,
            area_sqm,
            unit_price_psm,
            nett_price,
            property_type,
            number_of_units,
            tenure,
            completion_date,
            purchaser_address_indicator,
            postal_code,
            postal_district,
            postal_sector,
            planning_region,
            planning_area
        )),
        '#',
        CAST(transaction_row_number AS STRING)
    )) AS transaction_key,
    d.date_key AS sale_date_key,
    p.project_key,
    l.location_key,
    transacted_price,
    nett_price,
    area_sqft,
    area_sqm,
    unit_price_psf,
    unit_price_psm,
    number_of_units,
    type_of_sale,
